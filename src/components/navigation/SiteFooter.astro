---
import { footerNavItems, homeHref } from '../../data/navigation';
import {
  locationAddressLines,
  requireLocation,
  requireSiteDoc,
} from '../../lib/content';

const footerEntry = await requireSiteDoc('footer');
if (footerEntry.data.doc !== 'footer') {
  throw new Error('src/content/site/footer.md must declare doc: footer');
}
const footer = footerEntry.data;
const location = await requireLocation();
const addressLines = locationAddressLines(location);
const copyrightYear = new Date().getFullYear();
---
<footer>
  <div class="footer-pattern" aria-hidden="true"></div>
  <div class="footer-main">
    <div class="footer-col footer-col--identity">
      <a href={homeHref} class="footer-program-link">{footer.title}</a>
      <p class="footer-tagline">{footer.tagline}</p>
      <address class="footer-address">
        {addressLines.map((line) => (
          <span class="footer-address-line">{line}</span>
        ))}
      </address>
      <a href={location.maps_url} class="footer-directions" target="_blank" rel="noopener">
        {footer.maps_label} &#x2197;&#xFE0E;
      </a>
    </div>

    <nav class="footer-col footer-col--explore" aria-label={footer.explore_label}>
      <p class="footer-col-label t-label">{footer.explore_label}</p>
      <ul class="footer-nav-list">
        {footerNavItems.map((item) => (
          <li>
            <a href={item.href} class="footer-nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer-col footer-col--elsewhere">
      <p class="footer-col-label t-label">{footer.elsewhere_label}</p>
      <ul class="footer-nav-list">
        {footer.external_links.map((link) => (
          <li>
            <a
              href={link.href}
              class="footer-nav-link"
              target={link.external === false ? undefined : '_blank'}
              rel={link.external === false ? undefined : 'noopener'}
            >
              {link.label}{link.external === false ? '' : ' \u2197\uFE0E'}
            </a>
          </li>
        ))}
      </ul>
      <div class="footer-social">
        {footer.social_links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener" aria-label={link.label} class="footer-social-link">
            {link.label === 'Instagram' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
              </svg>
            )}
            {link.label === 'YouTube' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="5" width="20" height="14" rx="4"/>
                <polygon points="10,9 16,12 10,15" fill="currentColor" stroke="none"/>
              </svg>
            )}
            {link.label === 'LinkedIn' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="4"/>
                <line x1="8" y1="11" x2="8" y2="16"/>
                <line x1="8" y1="8" x2="8" y2="8.5"/>
                <path d="M12 16v-5"/>
                <path d="M12 11c0-1 1-2 2.5-2s2.5 1 2.5 3v4"/>
              </svg>
            )}
            {link.label !== 'Instagram' && link.label !== 'YouTube' && link.label !== 'LinkedIn' && (
              <span>{link.label}</span>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="footer-bar">
    <p class="footer-copy">© {copyrightYear} {footer.copyright_name}</p>
    <p class="footer-region">{location.region_label}</p>
  </div>
</footer>
