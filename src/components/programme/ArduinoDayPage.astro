---
import type { CollectionEntry } from 'astro:content';
import { resolveCtaHref } from '../../lib/content';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const copy = entry.data.arduino_day;
if (!copy) {
  throw new Error('arduino-day-2026.md is missing the arduino_day frontmatter section.');
}

const hero = copy.hero;
const about = copy.about;
const challenge = copy.challenge;
const timeline = copy.timeline;
const access = copy.access;
const details = copy.details;
const host = copy.host;
const faq = copy.faq;
const closing = copy.closing;
const pageNav = copy.page_nav ?? [];
const marqueeLoop = [...copy.marquee, ...copy.marquee];

function emphasize(text: string, phrase?: string): string {
  if (!phrase || !text.includes(phrase)) return text;
  return text.replace(phrase, `<em>${phrase}</em>`);
}

const quoteHtml = emphasize(about.quote, about.quote_emphasis);
---
<article class="arduino-day">
  <section id="hero" class="ad-hero" aria-labelledby="ad-hero-title">
    <div class="ad-hero-pattern" aria-hidden="true"></div>
    <div class="ad-container ad-hero-grid">
      <div class="ad-hero-copy fade-up">
        <p class="t-label ad-hero-kicker">{hero.kicker}</p>
        <h1 id="ad-hero-title" class="ad-hero-title">
          {hero.title_line}<br /><em>{hero.title_emphasis}</em>
        </h1>
        <p class="ad-hero-sub">{hero.sub}</p>
        <div class="ad-hero-actions">
          <a
            class="button button--accent"
            href={resolveCtaHref(hero.primary_cta.href)}
            target={hero.primary_cta.external ? '_blank' : undefined}
            rel={hero.primary_cta.external ? 'noopener' : undefined}
          >
            {hero.primary_cta.label}{hero.primary_cta.external ? ' \u2197\uFE0E' : ''}
          </a>
          <a class="button button--on-dark" href={resolveCtaHref(hero.secondary_cta.href)}>
            {hero.secondary_cta.label}
          </a>
        </div>
        {pageNav.length > 0 && (
          <nav class="ad-page-nav" aria-label="On this page">
            {pageNav.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>
        )}
      </div>

      <aside class="ad-hero-panel fade-up">
        <h2 class="ad-hero-panel-title">{hero.panel_title}</h2>
        <p>{hero.panel_body}</p>
        <dl class="ad-hero-meta">
          {hero.meta.map((row) => (
            <div class="ad-hero-meta-item">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </section>

  <div class="marquee-strip" aria-hidden="true">
    <div class="marquee-inner">
      {marqueeLoop.map((item) => <span>{item}</span>)}
    </div>
  </div>

  <section id="about" class="ad-section ad-section--light" aria-labelledby="ad-about-title">
    <div class="ad-container">
      <header class="ad-section-header fade-up">
        <span class="t-label ad-section-number">{about.number}</span>
        <h2 id="ad-about-title" class="ad-section-title">
          {about.title_lines.map((line, i) => (
            <>{i > 0 && <br />}{line}</>
          ))}
        </h2>
      </header>
      <div class="ad-divider"></div>
      <div class="ad-about-grid">
        <figure class="ad-quote fade-up">
          <blockquote set:html={quoteHtml} />
          <figcaption>{about.cite}</figcaption>
        </figure>
        <div class="ad-about-text fade-up">
          {about.paragraphs.map((p) => <p>{p}</p>)}
          <div class="ad-tag-row">
            {about.tags.map((tag) => <span class="ad-tag">{tag}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="challenge" class="ad-section ad-section--dark" aria-labelledby="ad-challenge-title">
    <div class="ad-container">
      <header class="ad-section-header fade-up">
        <span class="t-label ad-section-number">{challenge.number}</span>
        <div>
          <h2 id="ad-challenge-title" class="ad-section-title">
            {challenge.title_lines.map((line, i) => (
              <>{i > 0 && <br />}{line}</>
            ))}
          </h2>
          <p class="ad-section-intro">{challenge.intro}</p>
        </div>
      </header>
      <div class="ad-divider ad-divider--on-dark"></div>
      <div class="ad-challenge-grid">
        <article class="ad-card fade-up">
          <h3>{challenge.prototype_title}</h3>
          <p>{challenge.prototype_body}</p>
        </article>
        <article class="ad-card fade-up">
          <h3>{challenge.variations_title}</h3>
          <p>{challenge.variations_intro}</p>
          <ul class="ad-variation-list">
            {challenge.variations.map((item) => (
              <li>
                <strong>{item.title}</strong> — {item.description}
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section id="timeline" class="ad-section ad-section--light" aria-labelledby="ad-timeline-title">
    <div class="ad-container">
      <header class="ad-section-header fade-up">
        <span class="t-label ad-section-number">{timeline.number}</span>
        <div>
          <h2 id="ad-timeline-title" class="ad-section-title">
            {timeline.title_lines.map((line, i) => (
              <>{i > 0 && <br />}{line}</>
            ))}
          </h2>
          <p class="ad-section-intro ad-section-intro--muted">{timeline.intro}</p>
        </div>
      </header>
      <div class="ad-divider"></div>
      <div class="ad-timeline-grid">
        {timeline.blocks.map((block) => (
          <article class="ad-timeline-item fade-up">
            <p class="ad-timeline-time">{block.time}</p>
            <h3 class="ad-timeline-title">{block.title}</h3>
            <p class="ad-timeline-desc">{block.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="access" class="ad-section ad-section--soft" aria-labelledby="ad-access-title">
    <div class="ad-container">
      <header class="ad-section-header fade-up">
        <span class="t-label ad-section-number">{access.number}</span>
        <h2 id="ad-access-title" class="ad-section-title">
          {access.title_lines.map((line, i) => (
            <>{i > 0 && <br />}{line}</>
          ))}
        </h2>
      </header>
      <div class="ad-divider"></div>
      <div class="ad-access-grid">
        {access.audiences.map((item) => (
          <article class="ad-access-card fade-up">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="details" class="ad-section ad-section--light" aria-labelledby="ad-details-title">
    <div class="ad-container">
      <header class="ad-section-header fade-up">
        <span class="t-label ad-section-number">{details.number}</span>
        <h2 id="ad-details-title" class="ad-section-title">
          {details.title_lines.map((line, i) => (
            <>{i > 0 && <br />}{line}</>
          ))}
        </h2>
      </header>
      <div class="ad-divider"></div>
      <div class="ad-details-grid">
        <div class="ad-info-panel fade-up">
          <h3>{details.event_title}</h3>
          <dl class="ad-info-list">
            {details.event_rows.map((row) => (
              <div class="ad-info-row">
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="ad-info-panel fade-up">
          <h3>{details.materials_title}</h3>
          <ul class="ad-material-list">
            {details.materials.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="host" class="ad-section ad-section--dark" aria-labelledby="ad-host-title">
    <div class="ad-container">
      <header class="ad-section-header fade-up">
        <span class="t-label ad-section-number">{host.number}</span>
        <h2 id="ad-host-title" class="ad-section-title">
          {host.title_lines.map((line, i) => (
            <>{i > 0 && <br />}{line}</>
          ))}
        </h2>
      </header>
      <div class="ad-divider ad-divider--on-dark"></div>
      <div class="ad-host-grid">
        <figure class="ad-host-photo fade-up">
          <img src={host.image} alt={host.image_alt} loading="lazy" decoding="async" />
          <figcaption class="ad-host-caption">{host.caption}</figcaption>
        </figure>
        <div class="ad-host-content fade-up">
          <h3>
            {host.name_line} <em>{host.name_emphasis}</em>.
          </h3>
          {host.paragraphs.map((p) => <p>{p}</p>)}
          <div class="ad-host-actions">
            {host.links.map((link) => (
              <a
                class="button button--on-dark"
                href={resolveCtaHref(link.href)}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener' : undefined}
              >
                {link.label}{link.external ? ' \u2197\uFE0E' : ''}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="ad-section ad-section--light" aria-labelledby="ad-faq-title">
    <div class="ad-container">
      <header class="ad-section-header fade-up">
        <span class="t-label ad-section-number">{faq.number}</span>
        <h2 id="ad-faq-title" class="ad-section-title">
          {faq.title_lines.map((line, i) => (
            <>{i > 0 && <br />}{line}</>
          ))}
        </h2>
      </header>
      <div class="ad-divider"></div>
      <div class="ad-faq-list">
        {faq.items.map((item) => (
          <details class="ad-faq-item fade-up">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="cta" class="ad-closing" aria-labelledby="ad-cta-title">
    <div class="ad-closing-pattern" aria-hidden="true"></div>
    <div class="ad-container ad-closing-inner fade-up">
      <p class="t-label ad-closing-kicker">{closing.kicker}</p>
      <h2 id="ad-cta-title">
        {closing.title_before} <em>{closing.title_emphasis}</em>.
      </h2>
      <p>{closing.body}</p>
      <div class="ad-closing-actions">
        <a
          class="button button--accent"
          href={resolveCtaHref(closing.primary_cta.href)}
          target={closing.primary_cta.external ? '_blank' : undefined}
          rel={closing.primary_cta.external ? 'noopener' : undefined}
        >
          {closing.primary_cta.label}{closing.primary_cta.external ? ' \u2197\uFE0E' : ''}
        </a>
        <a class="button button--on-dark" href={resolveCtaHref(closing.secondary_cta.href)}>
          {closing.secondary_cta.label}
        </a>
      </div>
    </div>
  </section>
</article>

<style is:global>
  /* Scoped under .arduino-day — does not alter institutional page chrome */
  .editorial-main:has(.arduino-day) {
    padding-top: 0;
  }
  .arduino-day {
    --ad-soft: #faf9fc;
  }
  .arduino-day .ad-container {
    width: min(calc(100% - 48px), var(--max-width));
    margin: 0 auto;
  }
  .arduino-day .ad-hero {
    position: relative;
    min-height: min(100vh, 920px);
    display: flex;
    align-items: end;
    padding: 140px 0 72px;
    background: var(--deep-purple);
    color: var(--white);
    overflow: hidden;
  }
  .arduino-day .ad-hero-pattern {
    position: absolute;
    inset: 0;
    background-image: url('https://raw.githubusercontent.com/linalopes/SchoolAI-brand-kit/main/patterns/pattern-2.png');
    background-position: center;
    background-size: cover;
    opacity: 0.16;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .arduino-day .ad-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
    align-items: end;
  }
  .arduino-day .ad-hero-kicker {
    color: var(--pink);
    margin-bottom: var(--space-4);
  }
  .arduino-day .ad-hero-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 300;
    font-size: clamp(52px, 9vw, 114px);
    line-height: 0.95;
    letter-spacing: -0.05em;
    margin: 0 0 var(--space-4);
  }
  .arduino-day .ad-hero-title em {
    font-style: normal;
    color: var(--pink);
  }
  .arduino-day .ad-hero-sub {
    max-width: 680px;
    font-size: 20px;
    line-height: 1.75;
    color: var(--gray-green);
    margin: 0 0 var(--space-5);
  }
  .arduino-day .ad-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .arduino-day .ad-page-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-top: var(--space-4);
  }
  .arduino-day .ad-page-nav a {
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
  }
  .arduino-day .ad-page-nav a:hover {
    color: var(--turquoise);
    border-bottom-color: var(--turquoise);
  }
  .arduino-day .ad-hero-panel {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    padding: 24px;
    backdrop-filter: blur(6px);
  }
  .arduino-day .ad-hero-panel-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 300;
    font-size: 26px;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  .arduino-day .ad-hero-panel p {
    color: var(--gray-green);
    font-size: 16px;
    line-height: 1.8;
    margin: 0 0 12px;
  }
  .arduino-day .ad-hero-meta {
    display: grid;
    gap: 10px;
    margin: 18px 0 0;
  }
  .arduino-day .ad-hero-meta-item {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 12px;
    font-size: 15px;
    color: var(--gray-green);
  }
  .arduino-day .ad-hero-meta-item dt {
    color: var(--turquoise);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
  }
  .arduino-day .ad-hero-meta-item dd {
    margin: 0;
  }

  .arduino-day .ad-section {
    padding: 96px 0;
  }
  .arduino-day .ad-section--light {
    background: var(--white);
    color: var(--deep-purple);
  }
  .arduino-day .ad-section--soft {
    background: var(--ad-soft);
    color: var(--deep-purple);
  }
  .arduino-day .ad-section--dark {
    background: var(--deep-purple);
    color: var(--white);
  }
  .arduino-day .ad-section-header {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 20px;
    margin-bottom: 32px;
    align-items: start;
  }
  .arduino-day .ad-section-number {
    color: var(--pink);
    padding-top: 8px;
  }
  .arduino-day .ad-section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 300;
    font-size: clamp(36px, 5vw, 74px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .arduino-day .ad-section-intro {
    max-width: 720px;
    font-size: 18px;
    line-height: 1.8;
    color: var(--gray-green);
    opacity: 0.9;
    margin: 10px 0 0;
  }
  .arduino-day .ad-section-intro--muted {
    color: var(--deep-purple);
    opacity: 0.72;
  }
  .arduino-day .ad-divider {
    width: 100%;
    height: 1px;
    background: rgba(34, 17, 62, 0.12);
    margin: 0 0 42px;
  }
  .arduino-day .ad-divider--on-dark {
    background: rgba(255, 255, 255, 0.12);
  }

  .arduino-day .ad-about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .arduino-day .ad-quote {
    margin: 0;
    border-left: 2px solid var(--pink);
    padding-left: 20px;
  }
  .arduino-day .ad-quote blockquote {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 300;
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1.22;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
  }
  .arduino-day .ad-quote em {
    font-style: normal;
    color: var(--pink);
  }
  .arduino-day .ad-quote figcaption {
    font-family: 'Courier Prime', monospace;
    font-size: 14px;
    opacity: 0.55;
  }
  .arduino-day .ad-about-text p {
    margin: 0 0 16px;
    line-height: 1.9;
    color: rgba(34, 17, 62, 0.82);
  }
  .arduino-day .ad-tag-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  .arduino-day .ad-tag {
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: rgba(34, 17, 62, 0.72);
    text-transform: uppercase;
    padding: 5px 12px;
    border: 1px solid rgba(34, 17, 62, 0.16);
  }

  .arduino-day .ad-challenge-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 42px;
  }
  .arduino-day .ad-card {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    padding: 28px;
  }
  .arduino-day .ad-card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 300;
    font-size: 32px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
  }
  .arduino-day .ad-card p {
    color: var(--gray-green);
    line-height: 1.85;
    margin: 0;
  }
  .arduino-day .ad-variation-list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .arduino-day .ad-variation-list li {
    padding: 14px 16px;
    background: rgba(255, 255, 255, 0.04);
    border-left: 2px solid var(--turquoise);
    color: var(--white);
    line-height: 1.7;
  }

  .arduino-day .ad-timeline-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .arduino-day .ad-timeline-item {
    border: 1px solid rgba(34, 17, 62, 0.12);
    padding: 22px;
    min-height: 170px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .arduino-day .ad-timeline-item:hover {
    border-color: var(--pink);
    transform: translateY(-2px);
  }
  .arduino-day .ad-timeline-time {
    font-family: 'Courier Prime', monospace;
    font-size: 14px;
    color: var(--pink);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 10px;
  }
  .arduino-day .ad-timeline-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 300;
    font-size: 26px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
    color: var(--deep-purple);
  }
  .arduino-day .ad-timeline-desc {
    font-size: 16px;
    line-height: 1.8;
    color: rgba(34, 17, 62, 0.78);
    margin: 0;
  }

  .arduino-day .ad-access-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .arduino-day .ad-access-card {
    background: var(--white);
    border: 1px solid rgba(34, 17, 62, 0.12);
    padding: 24px;
  }
  .arduino-day .ad-access-card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 300;
    font-size: 26px;
    margin: 0 0 12px;
    letter-spacing: -0.02em;
    color: var(--deep-purple);
  }
  .arduino-day .ad-access-card p {
    font-size: 16px;
    line-height: 1.8;
    color: rgba(34, 17, 62, 0.78);
    margin: 0;
  }

  .arduino-day .ad-details-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 42px;
    align-items: start;
  }
  .arduino-day .ad-info-panel {
    border: 1px solid rgba(34, 17, 62, 0.12);
    padding: 28px;
  }
  .arduino-day .ad-info-panel h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 300;
    font-size: 30px;
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    color: var(--deep-purple);
  }
  .arduino-day .ad-info-list {
    margin: 0;
    display: grid;
    gap: 12px;
  }
  .arduino-day .ad-info-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
    font-size: 16px;
    line-height: 1.8;
  }
  .arduino-day .ad-info-row dt {
    font-family: 'Courier Prime', monospace;
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(34, 17, 62, 0.72);
    padding-top: 3px;
  }
  .arduino-day .ad-info-row dd {
    margin: 0;
    color: rgba(34, 17, 62, 0.88);
  }
  .arduino-day .ad-material-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .arduino-day .ad-material-list li {
    padding-left: 18px;
    position: relative;
    line-height: 1.8;
    color: rgba(34, 17, 62, 0.82);
  }
  .arduino-day .ad-material-list li::before {
    content: '•';
