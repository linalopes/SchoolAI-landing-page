---
import {
  loadEventsSnapshot,
  renderEventsMarkup,
  selectUpcomingEvents,
} from '../../lib/sheets/index.ts';

const snapshot = loadEventsSnapshot();
const upcoming = selectUpcomingEvents(snapshot.items);
const eventsHtml = renderEventsMarkup(upcoming);
---
<section id="programme">
  <div class="workshops-pattern" aria-hidden="true"></div>
  <div class="section-header fade-up">
    <span class="section-number t-label">05</span>
    <div>
      <h2 class="section-title">Programme</h2>
      <p class="section-intro">
        Research meets people. Open Research Studio, visits and research-based workshops create opportunities to encounter ongoing experiments and exchange knowledge.
      </p>
      <div class="section-actions">
        <a href="/programme/" class="button button--primary">View the Programme</a>
      </div>
    </div>
  </div>
  <div class="divider"></div>

  <div class="workshops-grid">
    <article class="workshop-card program-card fade-up">
      <div class="workshop-tag">Open Research Studio</div>
      <h3 class="workshop-name">Encounter ongoing research</h3>
      <p class="workshop-desc">An opportunity to see prototypes and talk about experiments in progress.</p>
    </article>
    <article class="workshop-card program-card fade-up">
      <div class="workshop-tag">Research-based workshops</div>
      <h3 class="workshop-name">Learn through practice</h3>
      <p class="workshop-desc">Hands-on activities emerging from current investigations, sharing methods, tools and discoveries.</p>
    </article>
    <article id="room-for-interaction" class="workshop-card program-card fade-up">
      <div class="workshop-tag">2026 · Workshop series</div>
      <h3 class="workshop-name">Room for Interaction</h3>
      <p class="workshop-desc">A program exploring body, space and interaction through seven independent sessions, presented with Glitch Lab.</p>
      <a href="/room-for-interaction.html" class="button button--accent button--sm">View the program</a>
    </article>
  </div>

  <div class="programme-events fade-up">
    <h3 class="programme-events-title t-label">Upcoming dates</h3>
    <p class="section-intro programme-events-intro">Public dates appear here when there is something to attend. The research continues between them.</p>
    <div
      class="events-list"
      id="events-list"
      data-feed="events"
      data-snapshot-at={snapshot.fetchedAt}
      set:html={eventsHtml}
    />
  </div>
</section>
