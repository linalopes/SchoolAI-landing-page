---
import { site } from '../../data/site';
---
<section id="research">
  <div class="method-pattern" aria-hidden="true"></div>
  <div class="section-header fade-up">
    <span class="section-number t-label">02</span>
    <div>
      <h2 class="section-title">Artificial<br>Emotion</h2>
      <p class="section-intro">
        Artificial Emotion is the School’s principal research project for 2027, exploring emotion through Kinetic Studies, Soft Mechanisms and Bio-signals.
      </p>
      <p class="callout">
        Follow the ongoing investigation through its open research notebook.
      </p>
      <div class="section-actions">
        <a href="/research/" class="button button--primary">Explore the research</a>
        <a href={site.researchNotebookUrl} target="_blank" rel="noopener" class="button button--primary">
          Research notebook &#x2197;&#xFE0E;
        </a>
      </div>
    </div>
  </div>
</section>
