---
import {
  loadEventsSnapshot,
  renderEventsMarkup,
  selectUpcomingEvents,
} from '../../lib/sheets/index.ts';

const snapshot = loadEventsSnapshot();
const upcoming = selectUpcomingEvents(snapshot.items);
const eventsHtml = renderEventsMarkup(upcoming);
---
<!-- ── EVENTS / UPDATES ── -->
<section id="events">
  <div class="events-pattern"></div>
  <div class="section-header fade-up">
    <span class="section-number t-label" style="color:var(--deep-purple);opacity:0.4;">07</span>
    <div>
      <h2 class="section-title">On<br>next</h2>
      <p class="section-intro">Public dates appear here when there is something to attend. The research continues between them.</p>
    </div>
  </div>
  <div class="divider"></div>
  <div
    class="events-list"
    id="events-list"
    data-feed="events"
    data-snapshot-at={snapshot.fetchedAt}
    set:html={eventsHtml}
  />
</section>
