---
import { loadHeroSnapshot, renderHeroCarouselMarkup } from '../../lib/sheets/index.ts';
import { site } from '../../data/site';

const hero = loadHeroSnapshot();
const carouselHtml = renderHeroCarouselMarkup(hero.items);
---
<!-- ── HERO ── -->
<section id="hero">
  <div class="hero-pattern"></div>
  <div class="hero-left">
    <div class="hero-content">
      <p class="t-label hero-eyebrow">School of Tomorrow's AI · {site.locationLine}</p>
      <h1 class="hero-title">
        Strange questions,<br><em>made material.</em>
      </h1>
      <p class="hero-tagline">
        {site.description}
      </p>
      <div class="hero-actions">
        <a href="/research/" class="button button--accent">Explore the research</a>
        <a href="/collaborate/" class="button button--on-dark">Collaborate with us</a>
      </div>
    </div>
    <div class="hero-scroll">
      <div class="hero-scroll-line"></div>
      <span>Scroll</span>
    </div>
  </div>
  <div
    class="hero-right"
    id="hero-carousel"
    data-feed="hero"
    data-snapshot-at={hero.fetchedAt}
    aria-roledescription="carousel"
    aria-label="Featured updates"
    set:html={carouselHtml}
  />
</section>
