---
import { loadHeroSnapshot, renderHeroCarouselMarkup } from '../../lib/sheets/index.ts';

const hero = loadHeroSnapshot();
const carouselHtml = renderHeroCarouselMarkup(hero.items);
---
<!-- ── HERO ── -->
<section id="hero">
  <div class="hero-pattern"></div>
  <div class="hero-left">
    <div class="hero-content">
      <p class="t-label hero-eyebrow">School of Tomorrow's AI · Wetzikon — Zürich, Switzerland</p>
      <h1 class="hero-title">
        Strange questions,<br><em>made material.</em>
      </h1>
      <p class="hero-tagline">
        School of Tomorrow's AI is an artistic research platform. It turns strange questions about science, technology and possible futures into experiments, prototypes and public experiences. AI, like other scientific and technical systems, is treated as material — with grain, resistance and surprise.
      </p>
      <div class="hero-actions">
        <a href="#collaborate" class="button button--accent">Work with the School</a>
        <a href="#investigation" class="button button--on-dark">Explore the research</a>
      </div>
    </div>
    <div class="hero-scroll">
      <div class="hero-scroll-line"></div>
      <span>Scroll</span>
    </div>
  </div>
  <div
    class="hero-right"
    id="hero-carousel"
    data-feed="hero"
    data-snapshot-at={hero.fetchedAt}
    aria-roledescription="carousel"
    aria-label="Featured updates"
    set:html={carouselHtml}
  />
</section>
