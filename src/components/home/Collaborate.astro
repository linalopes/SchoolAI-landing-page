---
import { site } from '../../data/site';

const contactHref = `mailto:${site.contactEmail}`;
---
<section id="collaborate">
  <div class="collaborate-pattern" aria-hidden="true"></div>
  <div class="section-header fade-up">
    <span class="section-number t-label">07</span>
    <div>
      <h2 class="section-title">Collaborate</h2>
      <p class="section-intro">
        Research grows through exchange. Collaborate on an investigation, offer access to technology, share expertise, contribute materials or help sustain the atelier.
      </p>
    </div>
  </div>
  <div class="divider"></div>
  <div class="invite-grid fade-up">
    <div class="invite">
      <span class="t-label invite-index">01</span>
      <h3 class="invite-title">Research &amp; students</h3>
      <p class="invite-desc">Propose a joint or independent investigation, or discuss a master’s project, thesis or final project.</p>
    </div>
    <div class="invite">
      <span class="t-label invite-index">02</span>
      <h3 class="invite-title">Partners &amp; commissions</h3>
      <p class="invite-desc">Offer access to equipment or expertise, or discuss experimental projects with companies and institutions.</p>
    </div>
    <div class="invite">
      <span class="t-label invite-index">03</span>
      <h3 class="invite-title">Contributions</h3>
      <p class="invite-desc">Share skills, time, materials or practical assistance — or inquire about supporting ongoing research.</p>
    </div>
  </div>
  <div class="collaborate-actions fade-up">
    <p class="collaborate-cta-note">Six pathways for working with the School.</p>
    <a href="/collaborate/" class="collaborate-cta-link">Explore collaboration &#x2192;&#xFE0E;</a>
    <a href={contactHref} class="contact-email collaborate-cta-email">{site.contactEmail}</a>
  </div>
</section>
