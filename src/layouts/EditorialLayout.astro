---
import BaseLayout from './BaseLayout.astro';
import SiteNav from '../components/navigation/SiteNav.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  canonicalPath?: string;
  viewportFitCover?: boolean;
}

const { title, description, image = null, canonicalPath, viewportFitCover = false } = Astro.props;
---
<BaseLayout
  title={title}
  description={description}
  image={image}
  canonicalPath={canonicalPath}
  viewportFitCover={viewportFitCover}
>
  <SiteNav />
  <main class="editorial-main">
    <slot />
  </main>
  <SiteFooter />
  <script>
    import { startHomepage } from '../scripts/homepage';
    startHomepage();
  </script>
</BaseLayout>
