---
import BaseLayout from './BaseLayout.astro';
import SiteNav from '../components/navigation/SiteNav.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  canonicalPath?: string;
}

const { title, description, image = null, canonicalPath } = Astro.props;
---
<BaseLayout title={title} description={description} image={image} canonicalPath={canonicalPath}>
  <SiteNav />
  <main class="editorial-main">
    <slot />
  </main>
  <SiteFooter />
  <script>
    import { startHomepage } from '../scripts/homepage';
    startHomepage();
  </script>
</BaseLayout>
