---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import Newsletter from '../../components/home/Newsletter.astro';
import {
  loadEventsSnapshot,
  renderEventsMarkup,
  renderPastEventsMarkup,
  selectPastEventsPreview,
  selectUpcomingEvents,
} from '../../lib/sheets/index.ts';
import { site } from '../../data/site';

const pageTitle = `Programme · ${site.title}`;
const description =
  'Open Research Studio, research-based workshops and public encounters at School of Tomorrow’s AI.';

const snapshot = loadEventsSnapshot();
const upcoming = selectUpcomingEvents(snapshot.items);
const upcomingHtml = renderEventsMarkup(upcoming);
const { recent, earlier } = selectPastEventsPreview(snapshot.items);
const recentHtml = renderPastEventsMarkup(recent);
const earlierHtml = earlier.length ? renderPastEventsMarkup(earlier) : '';
---
<EditorialLayout title={pageTitle} description={description}>
  <article class="editorial editorial--wide">
    <header class="editorial-header fade-up">
      <p class="t-label editorial-eyebrow">Programme</p>
      <h1 class="editorial-title">Programme</h1>
      <p class="editorial-lede">
        Research meets people. Open Research Studio, visits and research-based workshops create opportunities to encounter ongoing experiments and exchange knowledge.
      </p>
    </header>

    <section class="editorial-panel fade-up">
      <div class="workshops-grid programme-page-grid">
        <article class="workshop-card program-card">
          <div class="workshop-tag">Open Research Studio</div>
          <h2 class="workshop-name">Encounter ongoing research</h2>
          <p class="workshop-desc">An opportunity to see prototypes and talk about experiments in progress.</p>
        </article>
        <article class="workshop-card program-card">
          <div class="workshop-tag">Research-based workshops</div>
          <h2 class="workshop-name">Learn through practice</h2>
          <p class="workshop-desc">
            Hands-on activities emerging from the School’s ongoing investigations, sharing methods, tools and discoveries through practice.
          </p>
        </article>
        <article id="room-for-interaction" class="workshop-card program-card">
          <div class="workshop-tag">2026 · Workshop series</div>
          <h2 class="workshop-name">Room for Interaction</h2>
          <p class="workshop-desc">
            A program exploring body, space and interaction through seven independent sessions, presented with Glitch Lab.
          </p>
          <a href="/room-for-interaction.html" class="button button--accent button--sm">View the program</a>
        </article>
        <article class="workshop-card program-card">
          <div class="workshop-tag">28 March 2026 · Past public lab</div>
          <h2 class="workshop-name">Paper as Interface</h2>
          <p class="workshop-desc">
            A hybrid Arduino Day experiment using paper, simple electronics and live prototyping in Wetzikon.
          </p>
          <a href="/arduino-day-2026.html" class="button button--accent button--sm">Read about the lab</a>
        </article>
      </div>
    </section>

    <section class="editorial-panel fade-up" aria-labelledby="upcoming-events-heading">
      <h2 id="upcoming-events-heading" class="editorial-subtitle">Upcoming events</h2>
      <p class="prose-p">
        Public dates appear here when there is something to attend. The research continues between them.
      </p>
      <div
        class="events-list"
        id="events-list"
        data-feed="events"
        data-snapshot-at={snapshot.fetchedAt}
        set:html={upcomingHtml}
      />
    </section>

    <section class="editorial-panel fade-up" aria-labelledby="past-events-heading">
      <h2 id="past-events-heading" class="editorial-subtitle">Past events</h2>
      <p class="prose-p">
        A record of public encounters hosted by the School. Cancelled dates are omitted.
      </p>
      <div class="events-list events-list--past" set:html={recentHtml} />
      {earlier.length > 0 && (
        <details class="past-events-more">
          <summary class="past-events-more-summary">View earlier events</summary>
          <div class="events-list events-list--past" set:html={earlierHtml} />
        </details>
      )}
    </section>
  </article>

  <Newsletter />
</EditorialLayout>
