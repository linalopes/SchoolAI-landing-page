---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import WorkstationsDirectory from '../../components/atelier/WorkstationsDirectory.astro';
import { resolveCtaHref, requirePage } from '../../lib/content';
import { site } from '../../data/site';

const entry = await requirePage('atelier');
const atelier = entry.data.atelier;
if (!atelier) {
  throw new Error('atelier.md is missing the atelier frontmatter section.');
}
const pageTitle = `${entry.data.title} · ${site.title}`;
const ctas = entry.data.ctas ?? [];
---
<EditorialLayout title={pageTitle} description={entry.data.description}>
  <article class="editorial editorial--wide">
    <header class="editorial-header fade-up">
      {entry.data.eyebrow && <p class="t-label editorial-eyebrow">{entry.data.eyebrow}</p>}
      <h1 class="editorial-title">{entry.data.title}</h1>
      {entry.data.lede && <p class="editorial-lede">{entry.data.lede}</p>}
      {entry.data.meta && <p class="editorial-meta t-mono">{entry.data.meta}</p>}
    </header>

    <section class="editorial-panel fade-up">
      {atelier.body.map((paragraph) => (
        <p class="prose-p">{paragraph}</p>
      ))}
      <div class="section-actions">
        {ctas.map((cta) => {
          const href = resolveCtaHref(cta.href, {
            email: site.contactEmail,
            subject: cta.subject,
          });
          return (
            <a
              href={href}
              target={cta.external ? '_blank' : undefined}
              rel={cta.external ? 'noopener' : undefined}
              class="button button--primary"
            >
              {cta.label}{cta.external ? ' \u2197\uFE0E' : ''}
            </a>
          );
        })}
      </div>
    </section>

    <div class="location-3d fade-up atelier-tour">
      <iframe
        src="/space3d.html"
        class="location-3d-frame"
        title={atelier.tour_title ?? 'The Atelier in 3D'}
        allowfullscreen
      ></iframe>
      {atelier.tour_hint && <p class="location-3d-hint">{atelier.tour_hint}</p>}
    </div>

    <WorkstationsDirectory
      number={atelier.workstations_number}
      titleLines={atelier.workstations_title_lines}
      intro={atelier.workstations_intro}
    />
  </article>
</EditorialLayout>
