---
import EditorialLayout from '../layouts/EditorialLayout.astro';
import ArduinoDayPage from '../components/programme/ArduinoDayPage.astro';
import { requirePage } from '../lib/content';

const entry = await requirePage('arduino-day-2026');
const pageTitle = entry.data.title;
const description = entry.data.description;
---
<EditorialLayout
  title={pageTitle}
  description={description}
  canonicalPath="/arduino-day-2026.html"
>
  <ArduinoDayPage entry={entry} />
</EditorialLayout>
