---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { site } from '../../data/site';

const pageTitle = `Collaborate · ${site.title}`;
const description =
  'Research grows through exchange — collaboration pathways at School of Tomorrow’s AI.';
const contactHref = `mailto:${site.contactEmail}`;
const visitHref = `mailto:${site.contactEmail}?subject=${encodeURIComponent('Atelier visit')}`;

const pathways = [
  {
    title: 'Research Collaboration',
    description:
      'Propose a joint or independent investigation, including projects outside Artificial Emotion.',
    subject: 'Research collaboration',
  },
  {
    title: 'Student Research',
    description:
      'Get in touch about a master’s project, thesis or final project. Arrangements depend on the proposal and available capacity.',
    subject: 'Student research inquiry',
  },
  {
    title: 'Technology Partnerships',
    description:
      'Offer access to equipment, laboratories, technologies, scientific facilities or expertise.',
    subject: 'Technology partnership',
  },
  {
    title: 'Commissioned Research',
    description:
      'Discuss experimental projects, prototypes and research collaborations with companies or institutions.',
    subject: 'Commissioned research',
  },
  {
    title: 'Hands-on Contributions',
    description:
      'Share skills, time, materials, equipment, knowledge or practical assistance.',
    subject: 'Hands-on contribution',
  },
  {
    title: 'Financial Support',
    description:
      'Contribute to ongoing research, specific projects or atelier maintenance. Payment options will be confirmed before publication.',
    subject: 'Financial support inquiry',
  },
] as const;
---
<EditorialLayout title={pageTitle} description={description}>
  <article class="editorial editorial--wide">
    <header class="editorial-header fade-up">
      <p class="t-label editorial-eyebrow">Collaborate</p>
      <h1 class="editorial-title">Collaborate</h1>
      <p class="editorial-lede">Research grows through exchange.</p>
      <p class="prose-p">
        We welcome artists, researchers, students, laboratories, cultural institutions, companies and individuals interested in expanding what can be investigated, made and learned together.
      </p>
    </header>

    <section class="editorial-panel fade-up" aria-label="Collaboration pathways">
      <div class="pathway-grid">
        {pathways.map((pathway, index) => {
          const href = `mailto:${site.contactEmail}?subject=${encodeURIComponent(pathway.subject)}`;
          return (
            <article class="pathway-card">
              <span class="t-label pathway-index">{String(index + 1).padStart(2, '0')}</span>
              <h2 class="pathway-title">{pathway.title}</h2>
              <p class="pathway-desc">{pathway.description}</p>
              <a href={href} class="pathway-link">Get in touch &#x2192;&#xFE0E;</a>
            </article>
          );
        })}
      </div>
    </section>

    <section class="editorial-panel fade-up">
      <h2 class="editorial-subtitle">Contact the School</h2>
      <p class="prose-p">
        Access is arranged through conversation. The School does not offer formal employment, residency programmes, internships or unrestricted public entry.
      </p>
      <div class="section-actions">
        <a href={contactHref} class="button button--primary">Contact the School</a>
        <a href={visitHref} class="button button--primary">Arrange a visit</a>
        <a href={contactHref} class="contact-email">{site.contactEmail}</a>
      </div>
    </section>
  </article>
</EditorialLayout>
