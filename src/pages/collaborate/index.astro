---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import Contributors from '../../components/collaborate/Contributors.astro';
import FinancialSupport from '../../components/support/FinancialSupport.astro';
import { resolveCtaHref, requirePage } from '../../lib/content';
import { site } from '../../data/site';

const entry = await requirePage('collaborate');
const { pathways, contact_section, collaborate } = entry.data;
if (!pathways || !contact_section || !collaborate) {
  throw new Error('collaborate.md is missing required frontmatter sections.');
}
const pageTitle = `${entry.data.title} · ${site.title}`;
---
<EditorialLayout title={pageTitle} description={entry.data.description}>
  <article class="editorial editorial--wide">
    <header class="editorial-header fade-up">
      {entry.data.eyebrow && <p class="t-label editorial-eyebrow">{entry.data.eyebrow}</p>}
      <h1 class="editorial-title">{entry.data.title}</h1>
      {entry.data.lede && <p class="editorial-lede">{entry.data.lede}</p>}
      <p class="prose-p">{collaborate.intro}</p>
    </header>

    <section class="editorial-panel fade-up" aria-label="Collaboration pathways">
      <div class="pathway-grid">
        {pathways.map((pathway, index) => {
          const href = resolveCtaHref('mailto', {
            email: site.contactEmail,
            subject: pathway.subject,
          });
          return (
            <article class="pathway-card">
              <span class="t-label pathway-index">{String(index + 1).padStart(2, '0')}</span>
              <h2 class="pathway-title">{pathway.title}</h2>
              <p class="pathway-desc">{pathway.description}</p>
              <a href={href} class="pathway-link">
                {pathway.cta_label ?? 'Get in touch'} &#x2192;&#xFE0E;
              </a>
            </article>
          );
        })}
      </div>
    </section>

    <FinancialSupport />

    <Contributors />

    <section class="editorial-panel fade-up" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="editorial-subtitle">{contact_section.title}</h2>
      <p class="prose-p">{contact_section.note}</p>
      <div class="section-actions contact-actions">
        <a href={`mailto:${site.contactEmail}`} class="contact-email">{site.contactEmail}</a>
        {contact_section.ctas.map((cta) => (
          <a
            href={resolveCtaHref(cta.href, {
              email: site.contactEmail,
              subject: cta.subject,
            })}
            class="button button--primary"
          >
            {cta.label}
          </a>
        ))}
      </div>
    </section>
  </article>
</EditorialLayout>
