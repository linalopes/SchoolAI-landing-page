---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import ResearchArchive from '../../components/research/ResearchArchive.astro';
import { mailtoHref, requirePage } from '../../lib/content';
import { site } from '../../data/site';

const entry = await requirePage('research');
const { flagship, open_research, archive } = entry.data;
if (!flagship || !open_research || !archive) {
  throw new Error('research.md is missing required frontmatter sections.');
}
const pageTitle = `${entry.data.title} · ${site.title}`;
const contactHref = mailtoHref(site.contactEmail);
---
<EditorialLayout title={pageTitle} description={entry.data.description}>
  <article class="editorial editorial--wide">
    <header class="editorial-header fade-up">
      {entry.data.eyebrow && <p class="t-label editorial-eyebrow">{entry.data.eyebrow}</p>}
      <h1 class="editorial-title">{entry.data.title}</h1>
      {entry.data.lede && <p class="editorial-lede">{entry.data.lede}</p>}
    </header>

    <section id="artificial-emotion" class="editorial-panel fade-up">
      <p class="t-label editorial-eyebrow">{flagship.eyebrow}</p>
      <h2 class="editorial-subtitle">{flagship.title}</h2>
      <p class="prose-p">{flagship.intro}</p>
      <ul class="research-threads">
        {flagship.threads.map((thread) => (
          <li><strong>{thread.title}</strong> — {thread.description}</li>
        ))}
      </ul>
      <p class="prose-p">{flagship.closing}</p>
      <div class="section-actions">
        <a
          href={flagship.notebook_cta.href}
          target={flagship.notebook_cta.external ? '_blank' : undefined}
          rel={flagship.notebook_cta.external ? 'noopener' : undefined}
          class="button button--primary"
        >
          {flagship.notebook_cta.label}{flagship.notebook_cta.external ? ' \u2197\uFE0E' : ''}
        </a>
      </div>
    </section>

    <section class="editorial-panel fade-up">
      <h2 class="editorial-subtitle">{open_research.title}</h2>
      {open_research.paragraphs.map((paragraph) => (
        <p class="prose-p">{paragraph}</p>
      ))}
      {open_research.contact_label && (
        <p class="prose-p">
          <a href={contactHref}>{open_research.contact_label}</a>
        </p>
      )}
    </section>

    <ResearchArchive
      showHeading={true}
      sectionId="selected-research"
      sectionNumber=""
      titleLines={archive.title_lines}
      intro={archive.intro}
      cta={archive.cta}
    />
  </article>
</EditorialLayout>
